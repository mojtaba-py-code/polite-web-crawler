# politecrawl — example environment configuration
# Copy this file to `.env` (or export the variables) and fill in your values.
# Never commit your real `.env`; it is ignored by git.

# Identify your crawler with an honest, contactable User-Agent so site
# owners can reach you. Include a URL and/or email.
POLITECRAWL_USER_AGENT="mybot/1.0 (+https://me.example/bot; me@example.com)"

# Optional — only needed to scrape pages behind a login.
# Provided via the environment only (never on the command line); these are
# redacted from logs.
# Sent as: Authorization: Bearer <token>
#POLITECRAWL_AUTH_TOKEN=""
# Sent as: Cookie: <value>
#POLITECRAWL_COOKIE="session=..."
